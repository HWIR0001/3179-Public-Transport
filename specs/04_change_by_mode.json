{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Diverging stacked bars: change in trips per resident since 2018-19, by city and mode. Diamond = net; right-hand note = net change in total trips.",
 "config": {
  "font": "'Public Sans', 'Segoe UI', system-ui, sans-serif",
  "axis": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleColor": "#52606d",
   "labelColor": "#52606d",
   "gridColor": "#e4e7eb",
   "domainColor": "#9aa5b1",
   "tickColor": "#9aa5b1"
  },
  "legend": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "orient": "top",
   "direction": "horizontal"
  },
  "view": {
   "stroke": null
  },
  "title": {
   "fontSize": 13,
   "anchor": "start",
   "color": "#1f2933"
  }
 },
 "title": {
  "text": "Change in yearly trips per resident since 2018-19, by city and mode",
  "subtitle": "Per resident, so cities of different sizes can be compared. The note on the right gives each city's total net change."
 },
 "data": {
  "url": "data/city_mode_recovery.csv"
 },
 "width": "container",
 "height": 300,
 "transform": [
  {
   "calculate": "datum.mode == 'Heavy rail' || datum.mode == 'Train' || datum.mode == 'Metro' ? 'Train' : datum.mode == 'Light rail' || datum.mode == 'Tram' ? 'Tram / light rail' : datum.mode",
   "as": "mode"
  },
  {
   "calculate": "datum.trips_2024_25 * 1000000 / datum.pop_2024_25 - datum.trips_2018_19 * 1000000 / datum.pop_2018_19",
   "as": "change_pc"
  },
  {
   "calculate": "datum.trips_2024_25 - datum.trips_2018_19",
   "as": "change_abs"
  },
  {
   "joinaggregate": [
    {
     "op": "sum",
     "field": "change_pc",
     "as": "net_pc"
    },
    {
     "op": "sum",
     "field": "change_abs",
     "as": "net_abs"
    }
   ],
   "groupby": [
    "city"
   ]
  },
  {
   "calculate": "(datum.net_abs > 0 ? '+' : '\u2212') + format(abs(datum.net_abs), '.0f') + 'M trips'",
   "as": "net_lab"
  }
 ],
 "encoding": {
  "y": {
   "field": "city",
   "type": "nominal",
   "title": null,
   "sort": {
    "field": "net_pc",
    "op": "min",
    "order": "ascending"
   }
  }
 },
 "layer": [
  {
   "mark": {
    "type": "rule",
    "color": "#8a8f98"
   },
   "encoding": {
    "x": {
     "datum": 0,
     "type": "quantitative"
    }
   }
  },
  {
   "mark": {
    "type": "bar",
    "size": 16
   },
   "encoding": {
    "x": {
     "field": "change_pc",
     "type": "quantitative",
     "title": "Trips per resident per year, 2024-25 minus 2018-19",
     "scale": {
      "domain": [
       -36,
       14
      ],
      "nice": false
     }
    },
    "color": {
     "field": "mode",
     "type": "nominal",
     "scale": {
      "domain": [
       "Bus",
       "Train",
       "Tram / light rail",
       "Ferry"
      ],
      "range": [
       "#d9730d",
       "#1d4e89",
       "#17a398",
       "#8e5bc4"
      ]
     },
     "title": "Mode"
    },
    "order": {
     "field": "mode",
     "type": "nominal"
    },
    "tooltip": [
     {
      "field": "city"
     },
     {
      "field": "mode"
     },
     {
      "field": "change_pc",
      "title": "Change per resident",
      "format": "+.1f"
     },
     {
      "field": "change_abs",
      "title": "Change in total trips (millions)",
      "format": "+.1f"
     }
    ]
   }
  },
  {
   "mark": {
    "type": "point",
    "shape": "diamond",
    "filled": true,
    "size": 90,
    "color": "#1f2933",
    "stroke": "white"
   },
   "encoding": {
    "x": {
     "field": "net_pc",
     "type": "quantitative"
    },
    "tooltip": [
     {
      "field": "city"
     },
     {
      "field": "net_pc",
      "title": "Net change per resident",
      "format": "+.1f"
     },
     {
      "field": "net_abs",
      "title": "Net change in total trips (millions)",
      "format": "+.1f"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "window": [
      {
       "op": "row_number",
       "as": "rn"
      }
     ],
     "groupby": [
      "city"
     ]
    },
    {
     "filter": "datum.rn == 1"
    }
   ],
   "mark": {
    "type": "text",
    "align": "right",
    "fontSize": 11,
    "fontWeight": "bold",
    "color": "#1f2933"
   },
   "encoding": {
    "x": {
     "datum": 14,
     "type": "quantitative"
    },
    "text": {
     "field": "net_lab"
    }
   }
  },
  {
   "data": {
    "values": [
     {
      "x": 14,
      "y": "Melbourne",
      "t": "Net change, all trips"
     }
    ]
   },
   "mark": {
    "type": "text",
    "align": "right",
    "fontSize": 11,
    "fontStyle": "italic",
    "color": "#1f2933",
    "dy": -16
   },
   "encoding": {
    "x": {
     "field": "x",
     "type": "quantitative"
    },
    "y": {
     "field": "y",
     "type": "nominal"
    },
    "text": {
     "field": "t"
    }
   }
  },
  {
   "data": {
    "values": [
     {
      "x": -4,
      "y": "Perth",
      "t": "\u25c6 net per resident"
     }
    ]
   },
   "mark": {
    "type": "text",
    "align": "right",
    "fontSize": 11,
    "fontStyle": "italic",
    "color": "#1f2933",
    "dy": -14
   },
   "encoding": {
    "x": {
     "field": "x",
     "type": "quantitative"
    },
    "y": {
     "field": "y",
     "type": "nominal"
    },
    "text": {
     "field": "t"
    }
   }
  }
 ]
}