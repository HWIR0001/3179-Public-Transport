{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Map of every South East Queensland stop, station and wharf: colour = mode, opacity = boardings in July 2026 (TransLink origin-destination trips), with rail lines.",
 "config": {
  "font": "'Public Sans', 'Segoe UI', system-ui, sans-serif",
  "axis": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleColor": "#52606d",
   "labelColor": "#52606d",
   "gridColor": "#e4e7eb",
   "domainColor": "#9aa5b1",
   "tickColor": "#9aa5b1"
  },
  "legend": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "orient": "top",
   "direction": "horizontal"
  },
  "view": {
   "stroke": null
  },
  "title": {
   "fontSize": 13,
   "anchor": "start",
   "color": "#1f2933"
  }
 },
 "title": "South East Queensland: boardings at every stop, July 2026",
 "width": 390,
 "height": 540,
 "projection": {
  "type": "mercator",
  "scale": 27800,
  "center": [
   153.2,
   -27.6
  ]
 },
 "layer": [
  {
   "data": {
    "url": "data/seq_poa.json",
    "format": {
     "type": "json",
     "property": "features"
    }
   },
   "mark": {
    "type": "geoshape",
    "filled": false,
    "stroke": "#b8c2cc",
    "strokeWidth": 0.5,
    "opacity": 0.8,
    "clip": true
   },
   "encoding": {
    "stroke": {
     "datum": "Postcode boundary",
     "type": "nominal",
     "title": null,
     "scale": {
      "domain": [
       "Rail line",
       "Postcode boundary"
      ],
      "range": [
       "#4f7cac",
       "#b8c2cc"
      ]
     },
     "legend": {
      "orient": "bottom",
      "symbolType": "stroke",
      "symbolStrokeWidth": 2.5
     }
    }
   }
  },
  {
   "data": {
    "url": "data/bris_rail.geojson",
    "format": {
     "type": "json"
    }
   },
   "mark": {
    "type": "geoshape",
    "filled": false,
    "stroke": "#1d4e89",
    "strokeWidth": 1.1,
    "opacity": 0.6,
    "clip": true
   },
   "encoding": {
    "stroke": {
     "datum": "Rail line",
     "type": "nominal",
     "title": null,
     "scale": {
      "domain": [
       "Rail line",
       "Postcode boundary"
      ],
      "range": [
       "#4f7cac",
       "#b8c2cc"
      ]
     },
     "legend": {
      "orient": "bottom",
      "symbolType": "stroke",
      "symbolStrokeWidth": 2.5
     }
    }
   }
  },
  {
   "data": {
    "url": "data/bris_stops.csv"
   },
   "transform": [
    {
     "calculate": "datum.mode == 'Heavy rail' || datum.mode == 'Train' || datum.mode == 'Metro' ? 'Train' : datum.mode == 'Light rail' || datum.mode == 'Tram' ? 'Tram / light rail' : datum.mode",
     "as": "mode"
    },
    {
     "calculate": "(datum.mode == 'Bus' ? 0 : 1e7) + datum.boardings",
     "as": "z"
    },
    {
     "calculate": "datum.mode == 'Bus' ? 7 : 34",
     "as": "sz"
    }
   ],
   "mark": {
    "type": "circle",
    "clip": true
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "order": {
     "field": "z",
     "type": "quantitative"
    },
    "size": {
     "field": "sz",
     "type": "quantitative",
     "scale": null,
     "legend": null
    },
    "color": {
     "field": "mode",
     "type": "nominal",
     "scale": {
      "domain": [
       "Bus",
       "Train",
       "Tram / light rail",
       "Ferry"
      ],
      "range": [
       "#d9730d",
       "#1d4e89",
       "#17a398",
       "#8e5bc4"
      ]
     },
     "title": "Mode",
     "legend": {
      "orient": "none",
      "direction": "vertical",
      "symbolType": "circle",
      "symbolSize": 110,
      "symbolOpacity": 1,
      "labelFontSize": 11,
      "titleFontSize": 11,
      "legendX": 262,
      "legendY": 6
     }
    },
    "opacity": {
     "field": "boardings",
     "type": "quantitative",
     "title": "Boardings, July 2026",
     "scale": {
      "type": "symlog",
      "domain": [
       0,
       500000
      ],
      "range": [
       0.05,
       1
      ],
      "clamp": true
     },
     "legend": {
      "format": ",.0f",
      "values": [
       0,
       1000,
       10000,
       100000,
       500000
      ],
      "symbolFillColor": "#52606d",
      "symbolStrokeWidth": 0,
      "orient": "none",
      "direction": "vertical",
      "legendX": 262,
      "legendY": 104
     }
    },
    "tooltip": [
     {
      "field": "mode",
      "title": "Mode"
     },
     {
      "field": "boardings",
      "title": "Boardings in July 2026",
      "format": ",.0f"
     }
    ]
   }
  }
 ]
}