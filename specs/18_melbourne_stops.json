{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Dot map of every Melbourne stop, coloured by mode, over postcode outlines.",
 "config": {
  "font": "'Public Sans', 'Segoe UI', system-ui, sans-serif",
  "axis": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleColor": "#52606d",
   "labelColor": "#52606d",
   "gridColor": "#e4e7eb",
   "domainColor": "#9aa5b1",
   "tickColor": "#9aa5b1"
  },
  "legend": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "orient": "top",
   "direction": "horizontal"
  },
  "view": {
   "stroke": null
  },
  "title": {
   "fontSize": 13,
   "anchor": "start",
   "color": "#1f2933"
  }
 },
 "title": "Melbourne: every stop and station",
 "width": 390,
 "height": 440,
 "projection": {
  "type": "mercator",
  "scale": 31900,
  "center": [
   145.0,
   -37.9
  ]
 },
 "layer": [
  {
   "data": {
    "url": "data/melb_poa.json",
    "format": {
     "type": "json",
     "property": "features"
    }
   },
   "mark": {
    "type": "geoshape",
    "filled": false,
    "stroke": "#b8c2cc",
    "strokeWidth": 0.5,
    "opacity": 0.8,
    "clip": true
   },
   "encoding": {
    "stroke": {
     "datum": "Postcode boundary",
     "type": "nominal",
     "title": null,
     "scale": {
      "domain": [
       "Rail line",
       "Postcode boundary"
      ],
      "range": [
       "#4f7cac",
       "#b8c2cc"
      ]
     },
     "legend": {
      "orient": "bottom",
      "symbolType": "stroke",
      "symbolStrokeWidth": 2.5
     }
    }
   }
  },
  {
   "data": {
    "url": "data/melb_stops.csv"
   },
   "transform": [
    {
     "calculate": "datum.mode == 'Heavy rail' || datum.mode == 'Train' || datum.mode == 'Metro' ? 'Train' : datum.mode == 'Light rail' || datum.mode == 'Tram' ? 'Tram / light rail' : datum.mode",
     "as": "mode"
    },
    {
     "calculate": "datum.mode == 'Bus' ? 0 : datum.mode == 'Tram / light rail' ? 1 : 2",
     "as": "z"
    },
    {
     "calculate": "datum.mode == 'Bus' ? 3 : datum.mode == 'Train' ? 9 : datum.mode == 'Tram / light rail' ? 6 : 3",
     "as": "sz"
    }
   ],
   "mark": {
    "type": "circle",
    "opacity": 0.55,
    "clip": true
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "order": {
     "field": "z",
     "type": "quantitative"
    },
    "size": {
     "field": "sz",
     "type": "quantitative",
     "scale": null,
     "legend": null
    },
    "color": {
     "field": "mode",
     "type": "nominal",
     "scale": {
      "domain": [
       "Bus",
       "Train",
       "Tram / light rail",
       "Ferry"
      ],
      "range": [
       "#d9730d",
       "#1d4e89",
       "#17a398",
       "#8e5bc4"
      ]
     },
     "title": "Mode",
     "legend": {
      "orient": "top",
      "direction": "horizontal",
      "symbolType": "circle",
      "symbolSize": 110,
      "symbolOpacity": 1,
      "labelFontSize": 11,
      "titleFontSize": 11
     }
    },
    "tooltip": [
     {
      "field": "mode"
     }
    ]
   }
  }
 ]
}