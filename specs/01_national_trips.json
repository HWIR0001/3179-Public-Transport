{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Streamgraph of yearly trips by mode, all eight capitals. Bus sits under train so the share shift is visible; labels give 1977-2025 shares.",
 "config": {
  "font": "'Public Sans', 'Segoe UI', system-ui, sans-serif",
  "axis": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleColor": "#52606d",
   "labelColor": "#52606d",
   "gridColor": "#e4e7eb",
   "domainColor": "#9aa5b1",
   "tickColor": "#9aa5b1"
  },
  "legend": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "orient": "top",
   "direction": "horizontal"
  },
  "view": {
   "stroke": null
  },
  "title": {
   "fontSize": 13,
   "anchor": "start",
   "color": "#1f2933"
  }
 },
 "title": {
  "text": "Trips on city public transport, all eight capitals",
  "subtitle": "Bus share fell from 54% to 42% of trips while train rose from 35% to 43% (1977 to 2025)"
 },
 "data": {
  "url": "data/national_mode_share.csv"
 },
 "width": "container",
 "height": 300,
 "transform": [
  {
   "calculate": "datum.mode == 'Heavy rail' || datum.mode == 'Train' || datum.mode == 'Metro' ? 'Train' : datum.mode == 'Light rail' || datum.mode == 'Tram' ? 'Tram / light rail' : datum.mode",
   "as": "mode"
  },
  {
   "calculate": "datum.mode == 'Bus' ? 0 : datum.mode == 'Train' ? 1 : datum.mode == 'Tram / light rail' ? 2 : 3",
   "as": "ord"
  }
 ],
 "layer": [
  {
   "data": {
    "values": [
     {
      "a": 2019.5,
      "b": 2022.5
     }
    ]
   },
   "mark": {
    "type": "rect",
    "color": "#8a8f98",
    "opacity": 0.15
   },
   "encoding": {
    "x": {
     "field": "a",
     "type": "quantitative",
     "scale": {
      "domain": [
       1977,
       2025
      ],
      "zero": false,
      "nice": false
     }
    },
    "x2": {
     "field": "b"
    }
   }
  },
  {
   "mark": {
    "type": "area",
    "interpolate": "monotone",
    "opacity": 0.92
   },
   "encoding": {
    "x": {
     "field": "year_end",
     "type": "quantitative",
     "scale": {
      "domain": [
       1977,
       2025
      ],
      "zero": false,
      "nice": false
     },
     "title": "Year ending 30 June",
     "axis": {
      "format": "d",
      "tickMinStep": 5
     }
    },
    "y": {
     "field": "trips_million",
     "stack": "center",
     "axis": null,
     "type": "quantitative",
     "scale": {
      "domain": [
       0,
       1900
      ],
      "nice": false
     }
    },
    "color": {
     "field": "mode",
     "type": "nominal",
     "scale": {
      "domain": [
       "Bus",
       "Train",
       "Tram / light rail",
       "Ferry"
      ],
      "range": [
       "#d9730d",
       "#1d4e89",
       "#17a398",
       "#8e5bc4"
      ]
     },
     "title": "Mode"
    },
    "order": {
     "field": "ord",
     "type": "quantitative"
    },
    "tooltip": [
     {
      "field": "fy",
      "title": "Year"
     },
     {
      "field": "mode"
     },
     {
      "field": "trips_million",
      "title": "Trips (millions)"
     },
     {
      "field": "share_pct",
      "title": "Share of trips (%)"
     }
    ]
   }
