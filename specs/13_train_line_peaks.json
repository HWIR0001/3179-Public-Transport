{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Lollipop/bubble: share of each line's weekday travel in the two peaks; bubble size = line's share of all train travel.",
 "config": {
  "font": "'Public Sans', 'Segoe UI', system-ui, sans-serif",
  "axis": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleColor": "#52606d",
   "labelColor": "#52606d",
   "gridColor": "#e4e7eb",
   "domainColor": "#9aa5b1",
   "tickColor": "#9aa5b1"
  },
  "legend": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "orient": "top",
   "direction": "horizontal"
  },
  "view": {
   "stroke": null
  },
  "title": {
   "fontSize": 13,
   "anchor": "start",
   "color": "#1f2933"
  }
 },
 "title": "Melbourne trains: how much of each line's weekday travel falls in the two peaks",
 "data": {
  "url": "data/train_line_share.csv"
 },
 "width": "container",
 "height": 400,
 "transform": [
  {
   "calculate": "0",
   "as": "x0"
  }
 ],
 "encoding": {
  "y": {
   "field": "line",
   "type": "nominal",
   "title": null,
   "sort": {
    "field": "peak_share",
    "op": "max",
    "order": "descending"
   }
  }
 },
 "layer": [
  {
   "mark": {
    "type": "rule",
    "color": "#8a8f98",
    "strokeWidth": 1.5
   },
   "encoding": {
    "x": {
     "field": "x0",
     "type": "quantitative",
     "scale": {
      "domain": [
       0,
       100
      ],
      "nice": false
     }
    },
    "x2": {
     "field": "peak_share"
    }
   }
  },
  {
   "mark": {
    "type": "circle",
    "color": "#1d4e89",
    "opacity": 0.85,
    "stroke": "white",
    "strokeWidth": 1
   },
   "encoding": {
    "x": {
     "field": "peak_share",
     "type": "quantitative",
     "title": "Share of weekday travel in the two peaks (%)",
     "scale": {
      "domain": [
       0,
       100
      ],
      "nice": false
     }
    },
    "size": {
     "field": "share_pct",
     "type": "quantitative",
     "title": [
      "Share of all weekday",
      "train travel (%)"
     ],
     "scale": {
      "range": [
       60,
       900
      ],
      "zero": true
     },
     "legend": {
      "orient": "bottom",
      "values": [
       2,
       6,
       10
      ],
      "symbolFillColor": "#1d4e89"
     }
    },
    "tooltip": [
     {
      "field": "line",
      "title": "Line"
     },
     {
      "field": "peak_share",
      "title": "In the two peaks (%)"
     },
     {
      "field": "share_pct",
      "title": "Share of weekday train travel (%)"
     }
    ]
   }
  }
 ]
}