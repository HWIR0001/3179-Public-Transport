{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Flow map of Melbourne train stations: line width = estimated yearly passengers heading towards the city, built by adding station entries along each branch (build_flow.py); lines merge where branches join.",
 "config": {
  "font": "'Public Sans', 'Segoe UI', system-ui, sans-serif",
  "axis": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleColor": "#52606d",
   "labelColor": "#52606d",
   "gridColor": "#e4e7eb",
   "domainColor": "#9aa5b1",
   "tickColor": "#9aa5b1"
  },
  "legend": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "orient": "top",
   "direction": "horizontal"
  },
  "view": {
   "stroke": null
  },
  "title": {
   "fontSize": 13,
   "anchor": "start",
   "color": "#1f2933"
  }
 },
 "title": "Melbourne trains: estimated passengers heading towards the city, 2024-25 (millions a year)",
 "width": 520,
 "height": 470,
 "projection": {
  "type": "mercator",
  "scale": 34000,
  "center": [
   145.07,
   -37.88
  ]
 },
 "layer": [
  {
   "data": {
    "url": "data/melb_poa.json",
    "format": {
     "type": "json",
     "property": "features"
    }
   },
   "mark": {
    "type": "geoshape",
    "filled": false,
    "stroke": "#b8c2cc",
    "strokeWidth": 0.5,
    "opacity": 0.8,
    "clip": true
   },
   "encoding": {
    "stroke": {
     "datum": "Postcode boundary",
     "type": "nominal",
     "title": null,
     "scale": {
      "domain": [
       "Rail line",
       "Postcode boundary"
      ],
      "range": [
       "#4f7cac",
       "#b8c2cc"
      ]
     },
     "legend": {
      "orient": "bottom",
      "symbolType": "stroke",
      "symbolStrokeWidth": 2.5
     }
    }
   }
  },
  {
   "data": {
    "url": "data/melb_flow.csv"
   },
   "mark": {
    "type": "rule",
    "color": "#1d4e89",
    "strokeCap": "round",
    "opacity": 0.9,
    "clip": true
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "longitude2": {
     "field": "lon2"
    },
    "latitude2": {
     "field": "lat2"
    },
    "strokeWidth": {
     "field": "flow_million",
     "type": "quantitative",
     "scale": {
      "type": "sqrt",
      "domain": [
       0,
       71
      ],
      "range": [
       0.6,
       16
      ]
     },
     "legend": {
      "title": "Passengers a year (millions)",
      "values": [
       2,
       5,
       10,
       20,
       40,
       70
      ],
      "symbolType": "stroke",
      "symbolStrokeColor": "#1d4e89",
      "orient": "top",
      "direction": "horizontal"
     }
    },
    "order": {
     "field": "flow_million",
     "type": "quantitative"
    },
    "tooltip": [
     {
      "field": "from",
      "title": "From"
     },
     {
      "field": "to",
      "title": "Towards"
     },
     {
      "field": "flow_million",
      "title": "Passengers a year (millions)",
      "format": ".1f"
     }
    ]
   }
