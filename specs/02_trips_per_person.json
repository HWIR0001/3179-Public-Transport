  {
   "data": {
    "url": "data/city_mode_long.csv"
   },
   "params": [
    {
     "name": "pick",
     "select": {
      "type": "point",
      "fields": [
       "city"
      ],
      "on": "mouseover",
      "clear": "mouseout"
     }
    }
   ],
   "transform": [
    {
     "filter": "datum.fy == '2024-25'"
    },
    {
     "calculate": "datum.mode == 'Heavy rail' || datum.mode == 'Train' || datum.mode == 'Metro' ? 'Train' : datum.mode == 'Light rail' || datum.mode == 'Tram' ? 'Tram / light rail' : datum.mode",
     "as": "mode"
    },
    {
     "calculate": "datum.mode == 'Bus' ? 0 : datum.mode == 'Train' ? 1 : datum.mode == 'Tram / light rail' ? 2 : 3",
     "as": "ord"
    },
    {
     "stack": "trips_million",
     "groupby": [
      "city"
     ],
     "offset": "normalize",
     "as": [
      "a0",
      "a1"
     ],
     "sort": [
      {
       "field": "ord",
       "order": "ascending"
      }
     ]
    },
