{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "description": "Two line panels: monthly trips by mode vs the 2019 average (2019 = 100) for Sydney and Melbourne.",
 "config": {
  "font": "'Public Sans', 'Segoe UI', system-ui, sans-serif",
  "axis": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleColor": "#52606d",
   "labelColor": "#52606d",
   "gridColor": "#e4e7eb",
   "domainColor": "#9aa5b1",
   "tickColor": "#9aa5b1"
  },
  "legend": {
   "labelFontSize": 12,
   "titleFontSize": 12,
   "orient": "top",
   "direction": "horizontal"
  },
  "view": {
   "stroke": null
  },
  "title": {
   "fontSize": 13,
   "anchor": "start",
   "color": "#1f2933"
  }
 },
 "resolve": {
  "scale": {
   "y": "shared"
  }
 },
 "hconcat": [
  {
   "title": "Sydney",
   "width": 300,
   "height": 240,
   "data": {
    "url": "data/monthly_city_mode.csv",
    "format": {
     "parse": {
      "month": "date:'%Y-%m-%d'"
     }
    }
   },
   "transform": [
    {
     "filter": "datum.city == 'Sydney' && year(datum.month) >= 2018"
    },
    {
     "calculate": "datum.mode == 'Heavy rail' || datum.mode == 'Train' || datum.mode == 'Metro' ? 'Train' : datum.mode == 'Light rail' || datum.mode == 'Tram' ? 'Tram / light rail' : datum.mode",
     "as": "mode"
    }
   ],
   "layer": [
    {
     "mark": {
      "type": "rule",
      "strokeDash": [
       4,
       3
      ],
      "color": "#8a8f98"
     },
     "encoding": {
      "y": {
       "datum": 100
      }
     }
    },
    {
     "mark": {
      "type": "line",
      "strokeWidth": 1.8
     },
     "encoding": {
      "x": {
       "field": "month",
       "type": "temporal",
       "title": null,
       "axis": {
        "format": "%Y",
        "tickCount": 5
       }
      },
      "y": {
       "field": "index_2019",
       "type": "quantitative",
       "title": "Trips vs the same mode in 2019 (2019 average = 100)",
       "scale": {
        "domain": [
         0,
         140
        ]
       }
      },
      "color": {
       "field": "mode",
       "type": "nominal",
       "scale": {
        "domain": [
         "Bus",
         "Train",
         "Tram / light rail",
         "Ferry"
        ],
        "range": [
         "#d9730d",
         "#1d4e89",
         "#17a398",
         "#8e5bc4"
        ]
       },
       "title": "Mode"
      },
      "tooltip": [
       {
        "field": "month",
        "type": "temporal",
        "format": "%b %Y",
        "title": "Month"
       },
       {
        "field": "mode"
       },
       {
        "field": "trips_million",
        "title": "Trips (millions)"
       },
       {
        "field": "index_2019",
        "title": "Index (2019 = 100)"
       }
      ]
     }
    },
    {
     "data": {
      "values": [
       {
        "d": "2020-04-01T00:00:00",
        "y": 12,
        "t": "First COVID-19\nlockdowns"
       }
      ]
     },
     "mark": {
      "type": "text",
      "align": "left",
      "fontSize": 10.5,
      "fontStyle": "italic",
      "color": "#1f2933",
      "dx": 4,
      "lineBreak": "\n"
     },
     "encoding": {
      "x": {
       "field": "d",
       "type": "temporal"
      },
      "y": {
       "field": "y",
       "type": "quantitative"
      },
      "text": {
       "field": "t"
      }
     }
    },
    {
     "data": {
      "values": [
       {
        "d": "2024-06-01T00:00:00",
        "y": 128,
        "t": "Ferries above\n2019 levels"
       }
      ]
     },
     "mark": {
      "type": "text",
      "align": "right",
      "fontSize": 10.5,
      "fontStyle": "italic",
      "color": "#1f2933",
      "dx": -2,
      "lineBreak": "\n"
     },
     "encoding": {
      "x": {
       "field": "d",
       "type": "temporal"
      },
      "y": {
       "field": "y",
       "type": "quantitative"
      },
      "text": {
       "field": "t"
      }
     }
    }
   ]
  },
  {
   "title": "Melbourne",
   "width": 300,
   "height": 240,
   "data": {
    "url": "data/monthly_city_mode.csv",
    "format": {
     "parse": {
      "month": "date:'%Y-%m-%d'"
     }
    }
   },
   "transform": [
    {
     "filter": "datum.city == 'Melbourne' && year(datum.month) >= 2018"
    },
    {
     "calculate": "datum.mode == 'Heavy rail' || datum.mode == 'Train' || datum.mode == 'Metro' ? 'Train' : datum.mode == 'Light rail' || datum.mode == 'Tram' ? 'Tram / light rail' : datum.mode",
     "as": "mode"
    }
   ],
   "layer": [
    {
     "mark": {
      "type": "rule",
      "strokeDash": [
       4,
       3
      ],
      "color": "#8a8f98"
     },
     "encoding": {
      "y": {
       "datum": 100
      }
     }
    },
    {
     "mark": {
      "type": "line",
      "strokeWidth": 1.8
     },
     "encoding": {
      "x": {
       "field": "month",
       "type": "temporal",
       "title": null,
       "axis": {
        "format": "%Y",
        "tickCount": 5
       }
      },
      "y": {
       "field": "index_2019",
       "type": "quantitative",
       "title": "Trips vs the same mode in 2019 (2019 average = 100)",
       "scale": {
        "domain": [
         0,
         140
        ]
       }
      },
      "color": {
       "field": "mode",
       "type": "nominal",
       "scale": {
        "domain": [
         "Bus",
         "Train",
         "Tram / light rail",
         "Ferry"
        ],
        "range": [
         "#d9730d",
         "#1d4e89",
         "#17a398",
         "#8e5bc4"
        ]
       },
       "title": "Mode"
      },
      "tooltip": [
       {
        "field": "month",
        "type": "temporal",
        "format": "%b %Y",
        "title": "Month"
       },
       {
        "field": "mode"
       },
       {
        "field": "trips_million",
        "title": "Trips (millions)"
       },
       {
        "field": "index_2019",
        "title": "Index (2019 = 100)"
       }
      ]
     }
    },
    {
     "data": {
      "values": [
       {
        "d": "2020-04-01T00:00:00",
        "y": 12,
        "t": "Lockdowns"
       }
      ]
     },
     "mark": {
      "type": "text",
      "align": "left",
      "fontSize": 10.5,
      "fontStyle": "italic",
      "color": "#1f2933",
      "dx": 4,
      "lineBreak": "\n"
     },
     "encoding": {
      "x": {
       "field": "d",
       "type": "temporal"
      },
      "y": {
       "field": "y",
       "type": "quantitative"
      },
      "text": {
       "field": "t"
      }
     }
    },
    {
     "data": {
      "values": [
       {
        "d": "2026-01-01T00:00:00",
        "y": 116,
        "t": "Tram counting\nmethod changed"
       }
      ]
     },
     "mark": {
      "type": "text",
      "align": "right",
      "fontSize": 10.5,
      "fontStyle": "italic",
      "color": "#1f2933",
      "dx": -2,
      "lineBreak": "\n"
     },
     "encoding": {
      "x": {
       "field": "d",
       "type": "temporal"
      },
      "y": {
       "field": "y",
       "type": "quantitative"
      },
      "text": {
       "field": "t"
      }
     }
    }
   ]
  }
 ]
}